{
  "name": "nova-pdf-master",
  "private": true,
  "version": "1.0.0",
  "description": "NOVA PDF — every PDF tool, 100% in your browser. No uploads, no accounts, no servers.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4310",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4311",
    "deploy": "npm run build && wrangler deploy",
    "test:node": "node tests/node/core.test.mjs",
    "test:i18n": "node tests/i18n.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
