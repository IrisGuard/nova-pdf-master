{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-pdf",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "pdf.novaecosystem.live", "custom_domain": true },
    { "pattern": "www.pdf.novaecosystem.live", "custom_domain": true }
  ]
}
